{
  "name": "iobroker.fenecon",
  "version": "0.7.0",
  "description": "OpenEMS connection to fenecon pv",
  "author": {
    "name": "Georg Schreiner",
    "email": "info@sg-app.de"
  },
  "homepage": "https://github.com/sg-app/ioBroker.fenecon",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "fenecon",
    "openems",
    "FEMS",
    "PV inverter",
    "Energy storage system",
    "Energy management system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sg-app/ioBroker.fenecon.git"
  },
  "engines": {
    "node": ">= 24.22.2"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts --tst node24 --tsf cjs",
    "watch": "build-adapter ts --tst node24 --tsf cjs --watch",
    "test": "npm run test:ts && npm run test:package",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "generate:states": "node tools/generate-states.js src/states.ts && prettier --write src/states.ts",
    "benchmark": "node tools/benchmark.js",
    "translate": "translate-adapter",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/sg-app/ioBroker.fenecon/issues"
  },
  "readmeFilename": "README.md",
  "allowScripts": {
    "diskusage@1.2.0": false,
    "esbuild@0.11.23": true,
    "esbuild@0.25.12": false,
    "protobufjs@7.6.6": false,
    "unix-dgram@2.0.6": false
  }
}
